# Template for sampleConfig.cmake, loaded by find_package(sample) in the
# consumer's build. Turned into the real file by ../CMakeLists.txt.

# Generated code: install prefix from this file's location, set_and_check,
# check_required_components
@PACKAGE_INIT@

# No find_dependency here: the libraries have no external dependencies. With
# one (e.g. libA linking Eigen3::Eigen PUBLIC) add, before the include below:
#   include(CMakeFindDependencyMacro)
#   find_dependency(Eigen3 CONFIG)

# Load the targets file: defines sample::A, sample::B and (if built) sample::C
include("${CMAKE_CURRENT_LIST_DIR}/sampleTargets.cmake")

# A component counts as found when its target exists. Without a COMPONENTS
# list, sample_FIND_COMPONENTS is empty and the loop does nothing
foreach(comp IN LISTS sample_FIND_COMPONENTS)
  if(TARGET sample::${comp})
    set(sample_${comp}_FOUND TRUE)
  else()
    set(sample_${comp}_FOUND FALSE)
  endif()
endforeach()
# Fails find_package(sample COMPONENTS …) if a requested component is missing,
# e.g. COMPONENTS C from an install built with -DSAMPLE_BUILD_LIBC=OFF
check_required_components(sample)
