# prodsim-host: stands in for the prod RHEL9 host. Same base and repos as the
# ibn-dev image (podman/base.conf), but only the runtime RPMs the prodsim
# programs use: no compiler, no -devel packages, no dist/ libraries (those
# come from the mounted ~/workspace/ibn-dist, built there by build-dist.sh
# in ibn-dev).
# Xvfb + Mesa (llvmpipe) give prodsim-viewer an X display and OpenGL without
# a GPU. Build from the repo root:
#   podman build --build-arg-file podman/base.conf -t prodsim-host -f test/prodsim/host/Containerfile .
ARG BASE
ARG CONF_DIR

FROM $BASE
USER root
ARG CONF_DIR
COPY $CONF_DIR/ubi.repo /etc/yum.repos.d/ubi.repo
COPY $CONF_DIR/repos.sh /tmp/repos.sh
RUN /tmp/repos.sh && dnf -y install gdal-libs glfw glew libglvnd-glx libglvnd-opengl mesa-dri-drivers \
        xorg-x11-server-Xvfb procps-ng shadow-utils \
    && dnf clean all
ARG IBNDEV_USER
ARG IBNDEV_UID
ARG IBNDEV_GID
RUN set -e; \
    if ! id -u "$IBNDEV_USER" >/dev/null 2>&1; then \
      getent group "$IBNDEV_GID" >/dev/null || groupadd -g "$IBNDEV_GID" "$IBNDEV_USER"; \
      useradd -m -u "$IBNDEV_UID" -g "$IBNDEV_GID" "$IBNDEV_USER"; \
    fi; \
    mkdir -p /workspace && chown "$IBNDEV_UID:$IBNDEV_GID" /workspace
USER $IBNDEV_USER
WORKDIR /workspace
CMD ["bash"]
