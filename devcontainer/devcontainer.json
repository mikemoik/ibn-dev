// Template: copy to <project>/.devcontainer/devcontainer.json.
// Image: ibn-devcontainer (devcontainer/Containerfile, on top of ibn-dev), built once with
//   podman build --build-arg-file podman/base.conf -t ibn-dev -f podman/Containerfile.ibn-dev .
//   podman build --build-arg-file podman/base.conf -t ibn-devcontainer -f devcontainer/Containerfile .
// VS Code needs "dev.containers.dockerPath": "podman". uid/gid 1001 and the
// user "default" are KIDE_UID/KIDE_GID/KIDE_USER from podman/base.conf.
{
  "name": "ibn-devcontainer",
  "image": "localhost/ibn-devcontainer",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,Z",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=ibn-devcontainer-vscode,target=/home/default/.vscode-server,type=volume"
  ],
  "runArgs": ["--userns=keep-id:uid=1001,gid=1001", "--http-proxy=false"],
  "containerUser": "default",
  "remoteUser": "default",
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "llvm-vs-code-extensions.lldb-dap",
        "ms-vscode.cmake-tools",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "cmake.cmakePath": "/workspace/ibn-dist/bin/cmake",
        "clangd.path": "/usr/bin/clangd",
        "lldb-dap.executable-path": "/usr/bin/lldb-dap",
        "python.defaultInterpreterPath": "/usr/bin/python3.12"
      }
    }
  }
}
